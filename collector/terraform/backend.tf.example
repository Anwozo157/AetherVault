# Remote state in the customer's account (see docs/TERRAFORM.md).
# Copy to backend.tf (gitignored), fill in, then `terraform init -migrate-state`.
# Requires Terraform 1.10+ for use_lockfile.
terraform {
  backend "s3" {
    bucket       = "CUSTOMER-terraform-state"
    key          = "aethervault/drs-collector/us-west-2.tfstate"
    region       = "us-west-2"
    encrypt      = true
    use_lockfile = true
  }
}
