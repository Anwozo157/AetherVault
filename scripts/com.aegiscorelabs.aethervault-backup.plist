<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly database backup (Sundays 10:00 local; launchd runs it at next wake if the Mac was asleep).
     Install: cp to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that path>`.
     See docs/BACKUPS.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aegiscorelabs.aethervault-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>"$HOME/Developer/AetherVault/scripts/backup-db.sh"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/aethervault-backup.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/aethervault-backup.launchd.log</string>
</dict>
</plist>
