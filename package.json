{
  "name": "aethervault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p collector && tsc --noEmit -p collector-azure",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/check-bundle-size.mjs",
    "deploy": "bash scripts/deploy-pages.sh",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "e2e:console": "bash scripts/e2e-console.sh",
    "collector:build": "vite build -c collector/vite.config.ts --logLevel warn",
    "collector": "npm run collector:build && node dist-collector/cli/cli.mjs",
    "collector:package": "COLLECTOR_ENTRY=lambda npm run collector:build && cd dist-collector/lambda && zip -q -FS lambda.zip lambda.mjs THIRD_PARTY_NOTICES.txt && echo dist-collector/lambda/lambda.zip",
    "collector:azure:build": "vite build -c collector-azure/vite.config.ts --logLevel warn",
    "collector:azure": "npm run collector:azure:build && node dist-collector-azure/cli/cli.mjs",
    "collector:azure:package": "COLLECTOR_ENTRY=function npm run collector:azure:build && sh collector-azure/package.sh"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.119.0",
    "@types/three": "^0.187.0",
    "framer-motion": "^14.10.1",
    "lucide-react": "^0.454.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@aws-sdk/client-drs": "3.1156.0",
    "@azure/functions": "^4.17.1",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "d3-geo": "^3.1.2",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "^3.4.14",
    "topojson-client": "^3.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
