# Copy to .env.development.local (git-ignored) to enable the signed-in console in `npm run dev`.
# Use the .development.local name: Vite then ignores it for builds and tests, so the public
# GitHub Pages build can never point at your local database.
# Local values come from `npx supabase status -o env` (API_URL and ANON_KEY).
# The anon key is public by design; NEVER put the service_role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
